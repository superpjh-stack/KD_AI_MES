# 경동글로벌텍 제조AI 시스템 (SF26179182) — 환경변수
# 실제 값은 .env 에 둔다(.gitignore). 코드 상수로 박지 않는다(goal.md §10-1).
# `가설` 표시가 붙은 것은 사업계획서에 수치가 없어 임의로 정한 값이다 → 화면에 `가설 (D-nn)` 배지를 띄운다.

# ── DB ────────────────────────────────────────────────────────────────
KYUNGDONG_PG_DSN=postgresql:///kyungdong_db
KYUNGDONG_ENV=dev                          # dev | prod  (prod = 쿠키 Secure·HSTS, SESSION_SECRET 미설정 시 기동 거부)

# ── 세션·보안 ─────────────────────────────────────────────────────────
KYUNGDONG_SESSION_SECRET=                  # prod 필수. 비어 있으면 prod 기동 거부
# CSRF (D-60 · G-26). **켰다 (0 → 1).** 실측: POST 라우트 **31개 전부** `csrf.require()` 연결,
# 폼 6파일이 `csrf_field()` 매크로로 토큰을 싣는다. 토큰 왕복(발급→검증)도 실측 통과했다
# (tests/test_dev2_screens.py::test_G26_토큰이_없으면_403_있으면_통과한다 — 켠 상태·끈 상태를 둘 다 잰다).
#
# 켜지 못하던 이유 둘은 둘 다 해소됐다:
#   ① 테스트 하네스가 토큰을 싣지 않았다 → `tests/conftest.py` 의 `csrf_post()` 로 **전 파일 전환 완료**.
#      실제 브라우저처럼 화면을 열어 `name="_csrf"` 를 꺼내 폼에 싣는다. 검사를 우회하지 않는다.
#   ② `/api/ingest/plc`·`/api/ingest/gateway/resend`·`/api/cad/files`·`/api/docs/import` 는
#      **기계 클라이언트**(PLC·Gateway·배치)가 쿠키 없이 부른다 — CSRF 위협 모형의 대상이 아니다.
#      `util/csrf.EXEMPT_PATHS` 에 **사유와 함께** 4건만 면제한다. 브라우저가 부르는 경로는 하나도 면제하지 않는다.
#      면제 경로는 CSRF 가 아니라 **장비 등록(IF_DEVICE_REGISTRY) 기반 인증**으로 막아야 한다 — 아직 미구현이다.
# 켜졌으므로 화면 상단 `CSRF 미적용 (D-60)` 배지는 사라진다(G-30 — 꺼진 장치만 드러낸다).
KYUNGDONG_CSRF_ENFORCE=1
KYUNGDONG_SEED_PASSWORD=                   # 자동화 전용. 비우면 seed 가 계정별 난수를 1회 출력 (G-29)

# 계정 정책 — 사업계획서 9.2-2 는 "복잡도·주기적 변경" 만 적고 수치가 없다 → 가설 (D-16)
KYUNGDONG_PASSWORD_MIN_LEN=10              # 가설 (D-16)
KYUNGDONG_PASSWORD_COMPLEXITY_CLASSES=3    # 가설 (D-16) 대/소문자·숫자·특수 중 섞어야 할 종류 수 (개발1 D-116)
KYUNGDONG_PASSWORD_CHANGE_CYCLE_DAYS=90    # 가설 (D-16)
KYUNGDONG_LOGIN_FAIL_MAX=5                 # 가설 (D-16) 계정 단위
KYUNGDONG_RATE_LIMIT_IP=20                 # 가설 (D-16) IP 단위, 10분 창 (§10-12)
KYUNGDONG_SESSION_IDLE_MINUTES=30          # 가설 (D-16)

# ── LLM · 임베딩 (D-08: 사업계획서 4.7 은 Bedrock 만 적고 모델명·임베딩·차원 미정) ──
KYUNGDONG_LLM_PROVIDER=                    # 비우면 Agent 화면은 501 "LLM 미구성" 명시 렌더 (§2.5)
KYUNGDONG_LLM_MODEL=
KYUNGDONG_EMBED_PROVIDER=                  # 비우면 검색 모드 라벨 `tsvector_keyword` 표시 (D-08)

# ── RAG (D-09·D-10: 사업계획서에 임계값·응답시간·인용 정확도 목표가 없다) ──
KYUNGDONG_RAG_CONFIDENCE_MIN=0.70          # 가설 (D-10). 광성 사업의 0.85 는 다른 사업 값이라 쓰지 않는다
KYUNGDONG_RAG_TIMEOUT_SEC=10               # 가설 (D-09). 목표치 없음 — 실측만 보고한다

# ── CAD 파이프라인 (D-05: Autodesk API 계정·YOLOv8 가중치·OCR 미확보) ──
KYUNGDONG_CAD_PARSER=                      # autodesk | none. 비우면 501 또는 명시 배지. 조용한 합성 Feature 금지
KYUNGDONG_CAD_VISION_MODEL=                # yolov8 가중치 경로
KYUNGDONG_CAD_IOU_THRESHOLD=0.5            # 사업계획서 2.6-1 "예: 0.5 이상" — 확정값 (G-14)

# ── ML (D-04·D-12) ────────────────────────────────────────────────────
KYUNGDONG_DUE_DATE_TOLERANCE_DAYS=3        # 가설 (D-12). 2.6-4 "허용 오차 범위" 가 미기재
KYUNGDONG_ANCHOR_COUNT=5                   # 시간 앵커 분포 측정용 (goal.md §10-3)

# ── 수집 (D-06: 수집 지점 2개소뿐. 수집 주기 미기재) ──────────────────
KYUNGDONG_PLC_POLL_SEC=1                   # 가설 (D-06). 레이저커팅기 Master PLC 1지점만
KYUNGDONG_INGEST_STALE_SEC=60              # 가설 (D-09). 초과 시 화면 003/022 에 `수집 중단` 배지
KYUNGDONG_BOARD_REFRESH_SEC=30             # 가설 (D-09). 현황판 65" 2대 자동 갱신 주기

# ── 서버 ──────────────────────────────────────────────────────────────
KYUNGDONG_PORT=8020                        # 8000·8010 은 이웃 사업이 점유 중 (goal.md §8)
